<mxfile host="app.diagrams.net" modified="2026-05-01T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="exercise-flow" name="练习题生成流程">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="练习题生成与批改流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- 流程节点 -->
        <mxCell id="start" value="开始出题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="select_subject" value="选择学科&#xa;（语文/数学/英语等）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="select_type" value="选择题型&#xa;（选择/填空/判断/计算）&#xa;和题目数量" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="230" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gen_btn" value="点击【生成练习题】按钮" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dec_context" value="启用知识库&#xa;且有文档？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="400" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- 有文档路径 -->
        <mxCell id="retrieve" value="检索知识库&#xa;获取相关教学内容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="650" y="410" width="160" height="56" as="geometry" />
        </mxCell>

        <!-- 无文档路径 -->
        <mxCell id="no_context" value="无参考文档&#xa;直接生成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="140" height="56" as="geometry" />
        </mxCell>

        <!-- LLM生成 -->
        <mxCell id="generate" value="ExerciseGenerator&#xa;.generate_exercises()&#xa;LLM 生成练习题" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="display" value="显示练习题&#xa;供用户作答" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="answer" value="用户作答&#xa;填写答案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="700" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="submit" value="点击【提交答案】" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="770" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="check" value="自动批改&#xa;显示分数与解析" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="840" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="920" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="select_subject">
