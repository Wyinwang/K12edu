        <mxCell id="e6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;" edge="1" parent="1" source="dec_context" target="no_context">
          <mxGeometry relative="1" as="geometry">
