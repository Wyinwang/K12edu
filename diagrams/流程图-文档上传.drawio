<mxfile host="app.diagrams.net" modified="2026-05-01T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="upload-flow" name="文档上传流程">
    <mxGraphModel dx="800" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="文档上传流程（教师/管理员）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- 流程节点 -->
        <mxCell id="start" value="开始上传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="select" value="选择学科目录&#xa;（语文/数学/英语等）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="upload" value="上传 PDF/DOCX 文件&#xa;侧边栏上传组件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="process" value="DocumentProcessor&#xa;.process_file()&#xa;文档处理与分块" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="embed" value="生成向量嵌入&#xa;调用 Embedding API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="vector" value="VectorStore&#xa;.add_documents()&#xa;存入向量数据库" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="success" value="文档添加成功&#xa;可进行 RAG 问答" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="570" width="200" height="56" as="geometry" />
