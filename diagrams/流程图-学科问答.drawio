<mxfile host="app.diagrams.net" modified="2026-05-01T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="qa-flow" name="学科问答流程">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="学科问答流程（RAG问答）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- 流程节点 -->
        <mxCell id="start" value="开始问答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="select_subject" value="选择学科&#xa;（语文/数学/英语等）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="input" value="用户输入问题&#xa;文本输入框" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="230" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="dec_rag" value="启用&#xa;RAG？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="320" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- RAG路径 -->
        <mxCell id="search" value="VectorStore&#xa;.similarity_search()&#xa;向量相似度检索" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="context" value="构建上下文&#xa;拼接参考文档内容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="420" width="180" height="56" as="geometry" />
        </mxCell>

        <!-- 直接LLM路径 -->
        <mxCell id="direct_llm" value="直接调用 LLM&#xa;（无参考文档）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="160" height="56" as="geometry" />
        </mxCell>

        <!-- LLM处理 -->
        <mxCell id="llm" value="UnifiedLLM.chat()&#xa;Qwen 生成回答" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="display" value="显示回答&#xa;含参考来源（如有）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="200" height="56" as="geometry" />
        </mxCell>

        <mxCell id="save" value="保存到 chat_history&#xa;记录对话历史" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="650" y="600" width="180" height="56" as="geometry" />
        </mxCell>

        <mxCell id="end" value="结束本次问答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="690" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="select_subject">
          <mxGeometry relative="1" as="geometry" />
