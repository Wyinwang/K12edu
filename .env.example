# ==================== LLM API 配置 ====================
# 选择当前使用的LLM提供商: qwen, deepseek, toutiao, hunyuan, openai, gemini
LLM_PROVIDER=qwen

# 通义千问 (阿里云) - https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DeepSeek - https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 字节跳动 (豆包/头条) - https://console.volcengine.com/ark
TOUTIAO_API_KEY=your_toutiao_api_key_here

# 腾讯混元 - https://console.cloud.tencent.com/hunyuan
HUNYUAN_API_KEY=your_hunyuan_api_key_here

# OpenAI - https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Gemini (Google) - https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==================== 模型配置 ====================
# 各提供商默认模型
QWEN_MODEL=qwen-turbo
DEEPSEEK_MODEL=deepseek-chat
TOUTIAO_MODEL=doubao-pro-32k
HUNYUAN_MODEL=hunyuan-lite
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_MODEL=gemini-pro

# Embedding配置
# 选择Embedding提供商: qwen, openai, gemini
EMBEDDING_PROVIDER=openai

# Embedding模型
# 通义千问可选: text-embedding-v2, text-embedding-v3
# OpenAI可选: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Gemini可选: models/embedding-001, models/text-embedding-004
EMBEDDING_MODEL=text-embedding-3-small

# ==================== 向量数据库配置 ====================
CHROMA_PERSIST_DIR=./knowledge_base

# ==================== 文档上传目录 ====================
UPLOAD_DIR=./uploads

# ==================== RAG配置 ====================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3